{
	"name": "karmoy-fiskeapp",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "npm run db:setup && wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"cf-typegen": "wrangler types",
		"db:setup": "wrangler d1 migrations apply DB --local && npm run db:seed",
		"db:setup:remote": "wrangler d1 migrations apply DB --remote && npm run db:seed:remote",
		"db:seed": "wrangler d1 execute DB --local --file=seed.sql",
		"db:seed:remote": "wrangler d1 execute DB --remote --file=seed.sql"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.3",
		"leaflet": "^1.9.4",
		"typescript": "^5.5.2",
		"vite": "^8.3.8",
		"vitest": "~5.0.3",
		"wrangler": "^4"
	},
	"dependencies": {
		"hono": "^4.13.19"
	}
}
